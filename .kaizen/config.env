# --- Comandos del proyecto (detectados de Makefile/Cargo.toml y CI) ---
# Gate completo del repo: make fmt-check / make clippy / make test.
# clippy excluye gravital-talk-audit: spike_multipeer.rs tiene `listener` sin usar
# y el gate falla en main (ver AGENTS.md, "Gotchas conocidos").
# tests: el comando usado por .github/workflows/ci.yml, estable y sin deps de audio.
KZ_TEST_CMD="cargo test -p gravital-talk-core -p gravital-talk-metrics -p gravital-talk-transport --no-default-features"
KZ_LINT_CMD="cargo clippy --workspace --all-targets --exclude gravital-talk-audit -- -D warnings -W clippy::perf -W clippy::nursery"
KZ_FMT_CMD="make fmt-check"

# Comando que imprime SOLO un numero: porcentaje de cobertura. Vacio = no se mide.
KZ_COVERAGE_CMD=""
# Comando que imprime SOLO un numero: cantidad de advertencias de lint. Vacio = no se mide.
KZ_WARNINGS_CMD=""

# --- Generales ---
KZ_DEFAULT_BRANCH="main"
KZ_DRAFTS_DIR="docs/kaizen/pr-drafts"
# Solo codigo fuente: `app/` contiene app/build/ con .so y APK de cientos de MB,
# que inflan el conteo de lineas y falsean la deuda. `app/lib` es el Dart real.
KZ_SRC_GLOBS="crates app/lib"

# --- POLITICAS (1 = activa, 0 = desactivada). Elegidas por el usuario. ---
KZ_POLICY_COMMIT_MAX=256
KZ_POLICY_NO_EMOJI=1
KZ_POLICY_NO_AI_ATTRIBUTION=1
KZ_POLICY_BRANCH_PREFIXES_BLOCKED="claude/ codex/ opencode/"
