# Agente principal detectado: AGENTS.md + opencode.json + .opencode/ (sin CLAUDE.md ni GEMINI.md).
# klaude | codex | opencode | agy | custom
KL_AGENT="opencode"
# 1 = solo propone (instalado); 2 = auto-merge bajo riesgo; 3 = ademas bugfix verificado.
# Subir de nivel exige ADR firmado por una persona.
KL_AUTONOMY=1

KL_LOOPS="dev ops sweep research product"
KL_INTERVAL_SEC=3600
KL_MAX_TURNS=40
KL_TIMEOUT_SEC=1800
KL_MAX_RUNS_PER_DAY=24
KL_MAX_CONSEC_FAILS=3

# Rust: el workspace ya resuelve dependencias; cargo fetch es el setup real del repo.
KL_SETUP_CMD="cargo fetch"

# Lista de comandos permitidos si KL_AGENT=claude (el equivalente de opencode
# vive en el agente 'kaizen-loop' de opencode.json).
KL_CLAUDE_ALLOWED="Read,Edit,Write,Glob,Grep,Bash(git add:*),Bash(git commit:*),Bash(git status:*),Bash(git diff:*),Bash(git log:*),Bash(scripts/kaizen:*),Bash(scripts/kaizen-loop:*),Bash(cargo test:*),Bash(cargo clippy:*),Bash(cargo fmt:*),Bash(make fmt-check),Bash(python3 scripts/kaizen-insights.py:*),Bash(gh issue:*)"
# Solo si KL_AGENT=custom. Usa la variable $KL_PROMPT.
KL_CUSTOM_CMD=""

# Rutas protegidas: las del documento mas los contratos wire y la ABI C estable.
KL_PROTECTED_GLOBS=".github/* .githooks/* .kaizen/* scripts/kaizen* docs/kaizen/loop/* CODEOWNERS AGENTS.md CLAUDE.md GEMINI.md opencode.json .claude/* .agents/* .opencode/* *auth* *billing* *payment* *secret* *.env* migrations/* infra/* terraform/* Dockerfile* proto/* crates/gravital-talk-ffi/include/* docs/protocol-spec.md docs/packet-format.md"
KL_LOWRISK_GLOBS="docs/* *.md"
# Los tests de Rust viven en crates/<crate>/tests/, no en tests/ en la raiz.
KL_TEST_GLOBS="tests/* test/* crates/*/tests/* *_test.* *.test.* *.spec.* *_spec.*"
KL_LOWRISK_MAX_LINES=150
